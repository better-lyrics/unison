    <p begin="1:01.550" end="1:05.350" ttm:agent="v1" composer:groupId="g2" composer:instanceIdx="0" composer:templateLineIdx="3"><span begin="1:01.550" end="1:01.850">And</span> <span begin="1:01.850" end="1:02.200">no</span> <span begin="1:02.200" end="1:02.500">cred</span><span begin="1:02.500" end="1:02.850">it</span> <span begin="1:02.850" end="1:03.150">for</span> <span begin="1:03.150" end="1:03.500">end</span><span begin="1:03.500" end="1:03.800">ing</span> <span begin="1:03.800" end="1:04.050">a</span> <span begin="1:04.050" end="1:05.000">war!</span><span ttm:</span></span></p>
