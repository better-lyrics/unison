      <p begin="0:11.813" end="0:17.759" ttm:agent="v3"><span begin="0:11.813" end="0:12.134">Was</span> <span begin="0:12.134" end="0:12.415">it</span> <span begin="0:12.415" end="0:13.544">real?</span> <span begin="0:13.544" end="0:13.829">Was</span> <span begin="0:13.829" end="0:14.400">it</span> <span begin="0:14.400" end="0:14.966">mine?</span> <span begin="0:14.966" end="0:15.249">Was</span> <span begin="0:15.249" end="0:15.535">it</span> <span begin="0:15.535" end="0:15.824">worth</span> <span begin="0:15.824" end="0:17.759">it?</span></p>
