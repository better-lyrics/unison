    <metadata>
      <ttm:title>adrenaline!!! (《情色漫画老师》TV动画片尾曲)</ttm:title>
      <ttm:desc>Artist: TrySail</ttm:desc>
    </metadata>
  </head>
  <body>
    <div>
<p begin="00:00:17.176" end="00:00:19.823"><span begin="00:00:17.176" end="00:00:17.382">単</span><span begin="00:00:17.382" end="00:00:17.565">純</span><span begin="00:00:17.565" end="00:00:17.733">な</span><span begin="00:00:17.733" end="00:00:18.027">言</span><span begin="00:00:18.027" end="00:00:18.346">葉</span><span begin="00:00:18.346" end="00:00:18.657">重</span><span begin="00:00:18.657" end="00:00:18.906">ね</span><span begin="00:00:18.906" end="00:00:19.143">て</span><span begin="00:00:19.143" end="00:00:19.374">ゆ</span><span begin="00:00:19.374" end="00:00:19.823">く</span></p>
<p begin="00:00:20.071" end="00:00:23.951"><span begin="00:00:20.071" end="00:00:20.258">も</span><span begin="00:00:20.258" end="00:00:20.406">っ</span><span begin="00:00:20.406" end="00:00:20.653">と</span><span begin="00:00:20.653" end="00:00:21.023">心</span><span begin="00:00:21.023" end="00:00:21.394">は</span><span begin="00:00:21.394" end="00:00:21.633">素</span><span begin="00:00:21.633" end="00:00:21.987">直</span><span begin="00:00:21.987" end="00:00:23.951">で</span></p>
